# Optional public production site URL (without trailing slash), e.g.:
# VITE_SITE_URL="https://el-sultan.pages.dev"
# Leave empty on temporary preview deployments so canonical URLs and sitemaps
# are never pointed at an unauthorized domain.
VITE_SITE_URL=""

# Set to "true" ONLY on the authorized production deployment to allow search engine indexing.
# Preview and staging builds default to noindex/nofollow when this is unset or false.
VITE_ALLOW_INDEXING="false"
